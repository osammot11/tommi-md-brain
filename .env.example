# Copia in .env oppure passa le variabili al processo Node.
BRAIN_PASSWORD=change-this-long-password
BRAIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Token opzionale per futuri client server-to-server, incluso un MCP.
# BRAIN_API_TOKEN=replace-with-a-separate-random-token-at-least-32-characters
BRAIN_DATA_DIR=./data
BRAIN_BACKUP_DIR=./data-backups
BRAIN_BACKUP_RETENTION=7
PORT=3000
# Imposta a 1 quando l'app è servita dietro HTTPS (Caddy/Nginx).
BRAIN_SECURE_COOKIE=0
