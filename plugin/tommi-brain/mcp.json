{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tommi-brain": {
      "type": "streamable-http",
      "url": "https://brain.produceavalue.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "resource": "https://brain.produceavalue.com/mcp",
            "baseScopes": ["brain.read", "brain.write"]
          }
        }
      }
    }
  }
}
